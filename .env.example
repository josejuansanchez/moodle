# =============================================================================
#  Variables de configuración del despliegue de Moodle
#
#  Uso:
#     cp .env.example .env
#     chmod 600 .env        # contiene contraseñas: solo lo puede leer su dueño
#     nano .env             # rellena los valores vacíos
#
#  Contraseñas seguras:  openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
# =============================================================================

# --- Dominio y certificado TLS ----------------------------------------------
# Nombre de dominio que apunta a la IP pública de esta instancia.
DOMAIN=moodle.gotdns.ch
# Email al que Let's Encrypt envía los avisos de caducidad del certificado.
LE_EMAIL=

# --- Base de datos (MySQL) ---------------------------------------------------
DB_NAME=moodle
DB_USER=moodle
# Solo letras y números.
DB_PASS=

# --- Sitio Moodle ------------------------------------------------------------
MOODLE_SITE_FULLNAME="Campus Virtual"
MOODLE_SITE_SHORTNAME=Campus
MOODLE_LANG=es

# --- Administrador de Moodle -------------------------------------------------
MOODLE_ADMIN_USER=admin
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo (ej. Abc123*xyz).
MOODLE_ADMIN_PASS=
MOODLE_ADMIN_EMAIL=
